<script>
$(function() {
    if ($('.awe_login_slide').length>0){
        $('.awe_login_slide').aweLoginHandler({});
    }
    if ($('.awe_cookie').length>0){
        $('.awe_cookie').aweCookieHandler({});
    }
    else if ($('.awe_cookie_footer').length>0){
        $('.awe_cookie_footer').aweCookieHandler({});
